{
  "name": "caspian-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "projectName": "tsx settings/project-name.ts",
    "tailwind": "tsx settings/run-postcss.ts watch",
    "tailwind:build": "tsx settings/run-postcss.ts build",
    "browserSync": "tsx settings/bs-config.ts",
    "dev": "npm-run-all projectName -l -p browserSync tailwind",
    "build": "npm-run-all tailwind:build projectName",
    "format": "uv run python settings/format.py",
    "format:check": "uv run python settings/format.py --check",
    "check": "uv run python settings/check.py",
    "check:fix": "uv run python settings/fix.py",
    "logs": "uv run python settings/browser_log.py",
    "static": "npm run build && uv run python settings/build-static.py",
    "static:serve": "uv run python settings/serve-static.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/python": "^1.1.19",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/internals": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/browser-sync": "^2.29.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.21.0",
    "@types/prompts": "^2.4.9",
    "better-sqlite3": "^13.0.3",
    "browser-sync": "^3.0.4",
    "caspian-utils": "^0.2.18",
    "chalk": "^6.0.0",
    "cssnano": "^9.0.1",
    "http-proxy-middleware": "^4.0.0",
    "mariadb": "^3.5.3",
    "npm-run-all": "^4.1.5",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prisma": "^7.9.1",
    "prompts": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}